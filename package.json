{
  "name": "harness",
  "productName": "Harness",
  "version": "0.1.6",
  "description": "Agent harness on @cline/core with a Claude-Code-style desktop UI, talking to the cloudcode.one gateway.",
  "author": "CloudForge Oy <hello@cloudcode.one>",
  "homepage": "https://cloudcode.one",
  "type": "module",
  "main": "app/main.mjs",
  "desktopName": "harness.desktop",
  "scripts": {
    "start": "electron .",
    "smoke": "tsx cloudcode-smoke.ts",
    "postinstall": "node scripts/patch-cline-agents.mjs && node scripts/patch-cline-lenient-tools.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "dist": "npm run build:harness && electron-builder",
    "dist:linux": "npm run build:harness && electron-builder --linux deb",
    "dist:win": "npm run build:harness && electron-builder --win zip && node scripts/build-win-installer.mjs"
  },
  "dependencies": {
    "@cline/core": "^0.0.54",
    "jsonrepair": "^3.15.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "tsx": "^4.22.4"
  },
  "build": {
    "appId": "one.cloudcode.harness",
    "productName": "Harness",
    "copyright": "Copyright © 2026 CloudForge Oy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "cloudcode-harness.js",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "CloudForge Oy <hello@cloudcode.one>",
      "synopsis": "Agent harness desktop app for cloudcode.one",
      "description": "Claude-Code-style desktop chat for running @cline/core agent sessions against the cloudcode.one gateway.",
      "icon": "build/icons",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png"
    }
  }
}
